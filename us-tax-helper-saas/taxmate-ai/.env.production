# =============================================================================
# TaxMate AI — Production Environment Variables
# =============================================================================
# Set these in Vercel Project Settings → Environment Variables (Production).
# Do NOT commit real secrets. This file is a checklist / template only.
# =============================================================================

# App
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Database (Supabase / Neon / RDS)
# DATABASE_URL = pooled connection (PgBouncer, port 6543)
# DIRECT_URL   = direct connection for Prisma migrations
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# NextAuth
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_WHISPER_MODEL=whisper-1

# Vector DB (choose one)
VECTOR_STORE=pinecone
PINECONE_API_KEY=
PINECONE_INDEX=taxmate-irs-docs
PINECONE_NAMESPACE=irs-publications
# PG_VECTOR_URL=postgresql://...  # optional pgvector alternative

# Redis / Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379

# File storage (choose one)
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=taxmate-production-documents
AWS_S3_PUBLIC_URL=
# BLOB_READ_WRITE_TOKEN=  # if STORAGE_PROVIDER=vercel-blob

# Stripe
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_
NEXT_PUBLIC_STRIPE_PRICE_ID=price_
STRIPE_CONNECT_CLIENT_ID=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=TaxMate <noreply@yourdomain.com>

# SMS (Twilio — optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Monitoring
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Vercel Cron (set in Vercel only — never expose publicly)
CRON_SECRET=generate-random-secret

# Admin
ADMIN_EMAIL=admin@yourdomain.com

# QStash (optional background jobs)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Document worker (Railway / Render — separate from Vercel serverless)
DOCUMENT_WORKER_CONCURRENCY=2
