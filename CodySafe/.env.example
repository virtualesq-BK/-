# Threat Intelligence API Keys
# Obtain from: https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_KEY=

# Obtain from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_KEY=

# URLhaus uses a free public API; no key required
# URLHAUS_KEY=

# Obtain from: https://www.phishtank.com/api_info.php
PHISHTANK_KEY=

# Optional overrides
REDIRECT_MAX_FOLLOW=5
REQUEST_TIMEOUT_CONNECT=5
REQUEST_TIMEOUT_READ=10
RATE_LIMIT_PER_MINUTE=60
